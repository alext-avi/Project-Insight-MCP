{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug web host",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/servers/project-insight/src-web/bin/Debug/net10.0/ProjectInsightMCP.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/servers/project-insight/src-web/bin/Debug/net10.0",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:5001",
                "Web__PublicBaseUrl": "https://localhost:5001",
                "Storage__Mode": "Local",
                "ProjectInsight__DraftsPath": "${workspaceFolder}/servers/project-insight/src-web/bin/dev-drafts",
                "ProjectInsight__BaseUrl": "${env:ProjectInsight__BaseUrl}"
            },
            "preLaunchTask": "build"
        }
    ]
}
