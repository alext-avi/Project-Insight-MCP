{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/servers/project-insight/src-web/ProjectInsightMCP.Web.csproj"
			],
			"group": "build",
			"presentation": {
				"reveal": "silent"
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build stdio",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/servers/project-insight/src-stdio"
			],
			"group": "build",
			"presentation": {
				"reveal": "silent"
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "test",
			"command": "dotnet",
			"type": "process",
			"args": [
				"test",
				"${workspaceFolder}/servers/project-insight/tests"
			],
			"group": "test",
			"presentation": {
				"reveal": "always"
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch web",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/servers/project-insight/src-web/ProjectInsightMCP.Web.csproj"
			],
			"isBackground": true,
			"problemMatcher": "$msCompile"
		}
	]
}
