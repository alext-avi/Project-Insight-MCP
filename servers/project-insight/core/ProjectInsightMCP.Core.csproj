<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Transport-agnostic core: Project Insight API client, auth helpers and the MCP tool definitions/handlers, shared by the stdio and web hosts.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectInsightMCP</RootNamespace>
    <AssemblyName>ProjectInsightMCP.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Like the stdio host: no symbols in shipped builds, to avoid leaking local paths. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TimeChanges/Card/time-changes.html" LogicalName="ProjectInsightMCP.TimeChanges.Card.time-changes.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjectInsightMCP.Tests" />
  </ItemGroup>

</Project>
