<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Transport-agnostic core: Project Insight API client, auth helpers and the MCP tool
    definitions/handlers. net8.0 keeps the in-process Azure Functions host building until
    it is migrated (Phase 2); net10.0 is what the stdio host runs on.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectInsightMCP</RootNamespace>
    <AssemblyName>ProjectInsightMCP.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Like the stdio host: no symbols in shipped builds, to avoid leaking local paths. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TimeChanges/Card/time-changes.html" LogicalName="ProjectInsightMCP.TimeChanges.Card.time-changes.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjectInsightMCP.Tests" />
  </ItemGroup>

</Project>
