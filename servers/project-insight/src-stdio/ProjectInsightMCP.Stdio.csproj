<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>projectinsight-mcp</AssemblyName>
    <RootNamespace>ProjectInsightMCP.Stdio</RootNamespace>
    
    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>projectinsight-mcp</ToolCommandName>
    <PackageId>ProjectInsight.MCP</PackageId>
    <Version>1.3.4</Version>
    <Authors>Applied Visions Inc</Authors>
    <Company>Applied Visions Inc</Company>
    <Description>MCP (Model Context Protocol) Server for Project Insight integration with AI assistants like GitHub Copilot, Claude, and VS Code.</Description>
    <PackageTags>mcp;project-insight;ai;copilot;claude;vscode</PackageTags>
    <PackageProjectUrl>https://github.com/alext-avi/Project-Insight-MCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alext-avi/Project-Insight-MCP</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Self-contained single file for easier distribution -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    
    <!-- Exclude debug symbols to avoid path leakage -->
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
  </ItemGroup>

  <!-- Reference shared code from the main project -->
  <ItemGroup>
    <Compile Include="../src/Services/McpServerService.cs" Link="Services/McpServerService.cs" />
    <Compile Include="../src/Services/ProjectInsightApiService.cs" Link="Services/ProjectInsightApiService.cs" />
    <Compile Include="../src/Services/ProjectInsightAuthService.cs" Link="Services/ProjectInsightAuthService.cs" />
    <Compile Include="../src/Services/ApiTokenAccessor.cs" Link="Services/ApiTokenAccessor.cs" />
    <Compile Include="../src/Services/CredentialStorageService.cs" Link="Services/CredentialStorageService.cs" />
    <Compile Include="../src/Services/DeviceActivationService.cs" Link="Services/DeviceActivationService.cs" />
    <Compile Include="../src/Services/KeyVaultTokenService.cs" Link="Services/KeyVaultTokenService.cs" />
    <Compile Include="../src/Models/ProjectInsightModels.cs" Link="Models/ProjectInsightModels.cs" />
    <Compile Include="../../../shared/McpModels.cs" Link="Shared/McpModels.cs" />
    <Compile Include="../../../shared/McpConfiguration.cs" Link="Shared/McpConfiguration.cs" />
    <Compile Include="../../../shared/McpUtilities.cs" Link="Shared/McpUtilities.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
