<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- No packages.lock.json here: single-file publish makes it machine- and SDK-specific (RID, ILLink); its packages are pinned and the tests project's lock covers them. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>projectinsight-mcp</AssemblyName>
    <RootNamespace>ProjectInsightMCP.Stdio</RootNamespace>
    <!-- ModelContextProtocol.Extensions.Apps is marked experimental (MCPEXP003). -->
    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
    
    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>projectinsight-mcp</ToolCommandName>
    <PackageId>ProjectInsight.MCP</PackageId>
    <Version>2.1.0</Version>
    <Authors>Applied Visions Inc</Authors>
    <Company>Applied Visions Inc</Company>
    <Description>MCP (Model Context Protocol) Server for Project Insight integration with AI assistants like GitHub Copilot, Claude, and VS Code.</Description>
    <PackageTags>mcp;project-insight;ai;copilot;claude;vscode</PackageTags>
    <PackageProjectUrl>https://github.com/alext-avi/Project-Insight-MCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alext-avi/Project-Insight-MCP</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Self-contained single file for easier distribution -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    
    <!-- Exclude debug symbols to avoid path leakage -->
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../server/ProjectInsightMCP.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjectInsightMCP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
